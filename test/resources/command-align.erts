Name: Don't Align (or Consider Separators) Keywords in Strings or Comments

Point-Char: |

=-=
project Test is
   for Source_Dirs use (Project'Project_Dir);|
   X := "use"; -- use
   for Create_Missing_Dirs use"True";
   Foo := "case"; -- package
end Test;
=-=
project Test is
   for Source_Dirs         use (Project'Project_Dir);
   X   := "use";  -- use
   for Create_Missing_Dirs use "True";
   Foo := "case"; -- package
end Test;
