Name: attribute_declaration (broken line after "use")

Point-Char: |

=-=
project Test is
   for Languages use ("Ada");|
   for Source_Dirs use
     (Project'Project_Dir);
end Test;
=-=
project Test is
   for Languages   use ("Ada");
   for Source_Dirs use
     (Project'Project_Dir);
end Test;
=-=-=

Name: variable_declaration (Variable name containing "use" not aligned)

Point-Char: |

=-=
project Test is
   for Languages use ("Ada");|
   Foo_use_Bar := "Test";
end Test;
=-=
project Test is
   for Languages use ("Ada");
   Foo_use_Bar := "Test";
end Test;
=-=-=

Name: variable_declaration (broken line after colon)

Point-Char: |

=-=
project Test is
   Data : My_Type := "blah";|
   Z :
     My_Type := "blah";
end Test;
=-=
project Test is
   Data : My_Type := "blah";
   Z    :
     My_Type      := "blah";
end Test;
=-=-=

Name: variable_declaration (broken line after assignment)

Point-Char: |

=-=
project Test is
   Data : My_Type := "blah";|
   Z : My_Type :=
     "blah";
end Test;
=-=
project Test is
   Data : My_Type := "blah";
   Z    : My_Type :=
     "blah";
end Test;
