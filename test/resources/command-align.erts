Name: Align Buffer as Single Alignment Section

=-=
project Test is
   for Languages use ("Ada");
   for Create_Missing_Dirs use "True";

   for Source_Dirs use (Project'Project_Dir);
   for Object_Dir use "obj";
end Test;
=-=
project Test is
   for Languages           use ("Ada");
   for Create_Missing_Dirs use "True";

   for Source_Dirs         use (Project'Project_Dir);
   for Object_Dir          use "obj";
end Test;
