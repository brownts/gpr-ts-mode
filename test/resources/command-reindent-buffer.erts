Code: (lambda ()
        (default-transform)
        (gpr-ts-mode-reindent-buffer))

Point-Char: |

Name: Re-indent Buffer (Without Narrowing)

=-=
project Test is
for Languages use ("Ada");

package Builder is
for Switches (others) use ("-v");
   end Builder;

   -- 12345 67890 12345 67890 12345 67890 12345 67890 12345 67890
   -- 23456 78901 23456 78901 23456 78901 23456 78901 23456 78901 23456
   -- 34567 89012 34567 89012 34567 89012 34567 89012 34567 89012 34567
   -- 89012

package Compiler is|
for Default_Switches ("Ada") use ("-O0", "-g");
   end Compiler;

package Format is
for Indentation ("Ada") use "3";
   end Format;
end Test;
